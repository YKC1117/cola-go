{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://cola-go.example/schema/charging.schema.json",
  "$defs":{
    "station":{
      "type":"object",
      "required":["id","scope","name","connectorSummary","joinable"],
      "properties":{
        "id":{"type":"string"},"sourceId":{"type":["string","null"]},"scope":{"type":"string"},"name":{"type":"string"},
        "operatorId":{"type":["string","null"]},"address":{"type":["string","null"]},
        "lat":{"type":["number","null"]},"lon":{"type":["number","null"]},
        "connectorSummary":{"type":"array"},"hoursText":{"type":["string","null"]},"joinable":{"type":"boolean"}
      }
    },
    "availability":{
      "type":"object",
      "required":["id","state","identityQuality","joinable"],
      "properties":{
        "id":{"type":"string"},"stationId":{"type":["string","null"]},"chargingPointId":{"type":["string","null"]},
        "connectorType":{"type":["string","null"]},"state":{},"sourceUpdatedAt":{"type":["string","null"]},
        "identityQuality":{"enum":["connector-id","station-point","unreliable"]},"joinable":{"type":"boolean"}
      }
    }
  }
}

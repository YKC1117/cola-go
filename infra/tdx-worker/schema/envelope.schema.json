{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://cola-go.example/schema/envelope.schema.json",
  "type":"object",
  "required":["schemaVersion","status","source","stale","partial","items","coverage","pagination"],
  "properties":{
    "schemaVersion":{"const":1},
    "status":{"enum":["static","live","stale","partial","unavailable"]},
    "source":{"type":"string"},
    "scope":{"type":["string","null"]},
    "updatedAt":{"type":["string","null"]},
    "fetchedAt":{"type":["string","null"]},
    "expiresAt":{"type":["string","null"]},
    "stale":{"type":"boolean"},
    "partial":{"type":"boolean"},
    "snapshotId":{"type":["string","null"]},
    "items":{"type":"array"},
    "coverage":{
      "type":"object",
      "required":["supported","returned","total"],
      "properties":{
        "supported":{"type":"boolean"},
        "returned":{"type":"integer","minimum":0},
        "total":{"type":["integer","null"],"minimum":0}
      }
    },
    "pagination":{
      "type":"object",
      "required":["nextCursor"],
      "properties":{"nextCursor":{"type":["string","null"]}}
    },
    "error":{
      "type":["object","null"],
      "properties":{
        "code":{"type":"string"},
        "retryAfterSeconds":{"type":["integer","null"],"minimum":0}
      }
    }
  }
}
